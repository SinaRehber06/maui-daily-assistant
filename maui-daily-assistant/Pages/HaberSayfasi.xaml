<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiOdev3.Pages.HaberSayfasi"
             Title="Haberler">

    <Grid RowDefinitions="Auto, Auto, *">
        <ScrollView Grid.Row="0" Orientation="Horizontal" Padding="5">
            <HorizontalStackLayout Spacing="10">
                <Button Text="Manşet" Clicked="OnCategoryClicked" CommandParameter="https://www.trthaber.com/manset_articles.rss" />
                <Button Text="Gündem" Clicked="OnCategoryClicked" CommandParameter="https://www.trthaber.com/gundem_articles.rss" />
                <Button Text="Ekonomi" Clicked="OnCategoryClicked" CommandParameter="https://www.trthaber.com/ekonomi_articles.rss" />
                <Button Text="Spor" Clicked="OnCategoryClicked" CommandParameter="https://www.trthaber.com/spor_articles.rss" />
                <Button Text="Teknoloji" Clicked="OnCategoryClicked" CommandParameter="https://www.trthaber.com/bilim_teknoloji_articles.rss" />
            </HorizontalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="Yukleyici" Grid.Row="1" IsRunning="False" HorizontalOptions="Center" Color="#512BD4"/>

        <CollectionView x:Name="lstHaberler" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnHaberSecildi">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 10" Margin="10" Padding="0" BackgroundColor="#1E1E1E">
                        <Grid ColumnDefinitions="120, *" RowDefinitions="*, Auto" HeightRequest="110">
                            <Image Grid.Column="0" Grid.RowSpan="2" Source="{Binding Image}" Aspect="AspectFill" Margin="5"/>

                            <VerticalStackLayout Grid.Column="1" Padding="10" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" MaxLines="2" FontSize="14" TextColor="White"/>
                                <Label Text="{Binding Date}" FontSize="10" TextColor="Gray"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Grid.Row="1" Text="Paylaş" Clicked="OnShareClicked" 
                                    CommandParameter="{Binding .}" HorizontalOptions="End" Margin="5"
                                    HeightRequest="30" FontSize="10" BackgroundColor="#512BD4" TextColor="White"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>