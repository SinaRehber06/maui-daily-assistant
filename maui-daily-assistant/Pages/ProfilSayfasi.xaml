<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiOdev3.Pages.ProfilSayfasi"
             Title="Profil">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="15" Padding="20" VerticalOptions="Center">

                <Border StrokeShape="RoundRectangle 60" HeightRequest="120" WidthRequest="120" 
                        HorizontalOptions="Center" StrokeThickness="2" Stroke="Gray">
                    <Image Source="sina.jpg" Aspect="AspectFill" />
                </Border>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="Sina Rahbari" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="23670310047" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="Bartın Üniversitesi" FontSize="14" HorizontalOptions="Center" />
                    <Label Text="Bilgisayar Mühendisliği Bölümü" FontSize="14" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label x:Name="EmailLabel" Text="E-posta yükleniyor..." FontSize="16" 
                           TextColor="{AppThemeBinding Light=Blue, Dark=LightBlue}" HorizontalOptions="Center" />
                    <Label Text="Oturum Açık" FontSize="12" TextColor="Green" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Button Text="Çıkış Yap" Clicked="OnLogoutClicked" 
                        BackgroundColor="#FF3B30" TextColor="White" 
                        CornerRadius="10" Margin="0,30" WidthRequest="200" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="10" BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1e1e1e}">
            <Label Text="Bartın Üniversitesi Bilgisayar Mühendisliği Bölümü" 
                   HorizontalOptions="Center" FontSize="10" TextColor="Gray"/>
            <Label Text="ÖDEV-3" HorizontalOptions="Center" FontSize="10" TextColor="Gray"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>